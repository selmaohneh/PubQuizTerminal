{
  "name": "pubquizterminal",
  "version": "1.0.0",
  "description": "A terminal-based pub quiz application built with Electron",
  "main": "main.js",
  "scripts": {
    "server": "node server/index.js",
    "start": "electron . --no-sandbox",
    "dev": "electron . --dev --no-sandbox",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed"
  },
  "keywords": [
    "electron",
    "pub-quiz",
    "terminal",
    "quiz"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "playwright": "^1.56.1"
  },
  "build": {
    "appId": "com.pubquizterminal.app",
    "productName": "PubQuizTerminal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
